{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "metadata.json",
      "server.js",
      "copy-static.js",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/experience/**",
        "destination": "/experience.html"
      }
    ],
    "cleanUrls": true
  }
}
